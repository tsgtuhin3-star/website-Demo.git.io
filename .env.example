# Copy this file to .env. Replace the admin placeholder before signing in.
PORT=3000
HOST=127.0.0.1
STORE_DB_PATH=data/store.sqlite
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional: Razorpay test credentials enable the secure online checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
